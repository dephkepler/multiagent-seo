# direnv environment for local dev. Committed — contains only safe placeholders.
# Real secrets go to .envrc.local (gitignored, sourced at the bottom).
#
# Usage:
#   brew install direnv && direnv allow

# ── Server 
export CF_APP_PORT="8080"
export CF_APP_HOST="localhost"
export CF_APP_BASE_PATH="/"
export CF_APP_CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ── Database (matches devops/compose.yaml postgres service) 
export CF_DB_HOST="localhost"
export CF_DB_PORT="5432"
export CF_DB_USER="contentflow"
export CF_DB_PASSWORD="contentflow"
export CF_DB_NAME="contentflow"
export CF_DB_SSLMODE="disable"

# ── Sentry (off locally) 
export CF_SENTRY_ENABLED="false"
export CF_SENTRY_ENVIRONMENT="local"

# ── LLM 
export CF_LLM_PROVIDER="groq"
export CF_LLM_MODEL="llama-3.3-70b-versatile"
# Secrets — paste in .envrc.local:
# export CF_LLM_API_KEY=
# export CF_LLM_GROQ_API_KEY=
# export CF_LLM_CLAUDE_API_KEY=

# ── Google Sheets 
export CF_SHEETS_CREDENTIALS_FILE="./credentials.json"
export CF_SHEETS_SHEET="Keywords"
export CF_SHEETS_TOPIC_COLUMN="A"
export CF_SHEETS_KEYWORD_COLUMN="B"
export CF_SHEETS_TITLE_COLUMN="C"
export CF_SHEETS_HEADER_ROW="true"
# Secret-ish — paste in .envrc.local:
# export CF_SHEETS_SPREADSHEET_ID=

# ── Worker / Article
export CF_WORKER_POLL_INTERVAL="60s"
export CF_ARTICLE_LANGUAGE="ru"
export CF_ARTICLE_MIN_WORDS="1500"
export CF_ARTICLE_MAX_WORDS="3000"

# ── DataForSEO 
export CF_DATAFORSEO_SERP_LIMIT="5"
# export CF_DATAFORSEO_LOGIN=
# export CF_DATAFORSEO_PASSWORD=

# ── Checker 
export CF_CHECKER_PROVIDER="mock"
export CF_CHECKER_AI_THRESHOLD="0.8"
export CF_CHECKER_MAX_CYCLES="3"
# export CF_CHECKER_API_KEY=
# export CF_CHECKER_MODEL=

# ── Pexels 
export CF_PEXELS_ENABLED="true"
# export CF_PEXELS_API_KEY=

# Local overrides — gitignored, put real secrets here.
source_env_if_exists .envrc.local
