# Copy to backend/.env and fill in. Loaded into the app container by docker compose
# (env_file) and exported by the Makefile — everything here takes effect.

# ── Postgres ──
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=contentflow
POSTGRES_DB=contentflow
POSTGRES_HOST_PORT=55432
APP_HOST_PORT=8080

# ── LLM (provider/model default to groq/llama-3.3-70b; override only if needed) ──
CF_LLM_API_KEY=
CF_LLM_CLAUDE_API_KEY=

# ── DataForSEO (SERP; login+password empty → mock) ──
CF_DATAFORSEO_LOGIN=
CF_DATAFORSEO_PASSWORD=
CF_DATAFORSEO_SERP_LIMIT=5

# ── Google Sheets (empty SPREADSHEET_ID → in-memory mock) ──
CF_SHEETS_SPREADSHEET_ID=
CF_SHEETS_CREDENTIALS_FILE=./credentials.json
CF_SHEETS_SHEET=casino2
CF_SHEETS_TOPIC_COLUMN=A
CF_SHEETS_KEYWORD_COLUMN=B
CF_SHEETS_TITLE_COLUMN=C
CF_SHEETS_HEADER_ROW=true

# ── Originality checker (mock until a real provider is set) ──
CF_CHECKER_PROVIDER=mock
CF_CHECKER_API_KEY=
CF_CHECKER_MODEL=
CF_CHECKER_AI_THRESHOLD=0.8
CF_CHECKER_MAX_CYCLES=3
CF_CHECKER_COPYLEAKS_EMAIL=

# ── Prompt evolution (off unless a real checker is configured) ──
CF_PROMPT_EVOLVE_ENABLED=false
CF_PROMPT_HUMAN_WEIGHT=0.65

# ── Pexels (stock images) ──
CF_PEXELS_ENABLED=true
CF_PEXELS_API_KEY=

# ── Abalis: заявки с почты в Telegram ──
CF_TELEGRAM_BOT_TOKEN=
CF_TELEGRAM_CHAT_ID=
CF_TELEGRAM_PAYMENT_CARD=
CF_TELEGRAM_ALLOWED_USERS=

# ── Abalis: почта, откуда читаем заявки (IMAP) ──
CF_MAIL_IMAP_HOST=
CF_MAIL_IMAP_PORT=993
CF_MAIL_USERNAME=
CF_MAIL_PASSWORD=
CF_MAIL_FOLDER=INBOX

# ── Abalis: отдельная Google Таблица под заявки (НЕ CF_SHEETS_SPREADSHEET_ID выше) ──
CF_LEADS_SHEETS_SPREADSHEET_ID=
CF_LEADS_SHEETS_SHEET=customers
