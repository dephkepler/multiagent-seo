# Скопируйте в `.env` и подставьте значения. Не коммитьте `.env`.

# --- PostgreSQL (Alembic, worker, demo) ---
#
# Вариант A — Docker (удобно для локальной разработки):
#   docker compose up -d postgres
# Подключение с вашей машины (worker, alembic, psql): хост localhost, порт POSTGRES_PORT,
# пользователь/пароль/имя БД — как в переменных ниже (они же задают контейнер).
# Пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD (спецсимволы в пароле — URL-кодируйте).
#
POSTGRES_USER=seo_os
POSTGRES_PASSWORD=seo_os
POSTGRES_DB=seo_os
POSTGRES_PORT=5432
#
# Строка для SQLAlchemy (с хоста: localhost, не имя сервиса docker):
DATABASE_URL=postgresql+psycopg://seo_os:seo_os@localhost:5432/seo_os
#
# Если на машине уже занят порт 5432 — например POSTGRES_PORT=5433 и:
# DATABASE_URL=postgresql+psycopg://seo_os:seo_os@localhost:5433/seo_os
#
# Проверка из терминала:  psql "postgresql://seo_os:seo_os@127.0.0.1:5432/seo_os"
# Другой контейнер в той же сети compose: хост postgres, порт 5432 (см. docker-compose.yml).
#
# Вариант B — свой PostgreSQL без Docker: создайте БД и пользователя и задайте один DATABASE_URL.

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=seo-os-local

# Trello REST API — https://developer.atlassian.com/cloud/trello/rest/
# 1) API key (долгоживущий): https://trello.com/power-ups/admin → ваш Power-Up / ключ приложения.
# 2) Токен пользователя — НЕ запрашивается кодом при каждом вызове API. Один раз вручную:
#    выполните `seo-os-trello-auth` (или соберите URL ниже), откройте ссылку в браузере,
#    после подтверждения скопируйте token со страницы в TRELLO_TOKEN.
#    С expiration=never тот же токен хранится в .env и переиспользуется worker’ом.
#
#    Шаблон ссылки (подставьте YOUR_API_KEY):
#    https://trello.com/1/authorize?expiration=never&scope=read%2Cwrite&response_type=token&name=SEO+OS&key=YOUR_API_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=

# ID списков на доске — проще всего: `seo-os-trello-lists` (печатает таблицу и блок для .env).
# Если на доске ещё нет колонок Inbox … Blocked: `seo-os-trello-lists --bootstrap`
# (создаёт недостающие списки с английскими именами; порядок колонок при необходимости подвиньте в UI).
# Доска: https://trello.com/b/qPDyVJen/seo-agent
TRELLO_LIST_INBOX=
TRELLO_LIST_KEYWORD_RESEARCH=
TRELLO_LIST_CONTENT_DRAFT=
TRELLO_LIST_QA=
TRELLO_LIST_DONE=
TRELLO_LIST_BLOCKED=
# Опционально для keyword-очереди (Telegram /kw_new + poller):
# TRELLO_LIST_KEYWORD_TODO=
# TRELLO_LIST_KEYWORD_INPROGRESS=

# Опционально: short link доски для человекочитаемых логов
TRELLO_BOARD_SHORT_LINK=qPDyVJen

# --- HTTP API чата (FastAPI + uvicorn) ---
# CHAT_API_HOST=127.0.0.1
# CHAT_API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Запуск: seo-os-api   или   seo-os-api --reload
# Проверка: curl http://127.0.0.1:8000/health
#
# Старт кампании (Temporal): POST /v1/campaign/start с заголовком X-Campaign-Start-Key
# (значение = CAMPAIGN_START_SECRET). Без секрета эндпоинт отключён.
# CAMPAIGN_START_SECRET=

# --- LLM (чат POST /v1/chat через seo-os-api) ---
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
#
# Узлы LangGraph / Trello-пайплайн пока без вызова модели — только HTTP-чат и Telegram-бот используют ключ.

# --- Telegram-бот (тот же complete_chat, что POST /v1/chat) ---
# Токен только из @BotFather, только в .env, не в git. При утечке — /revoke и новый токен.
# TELEGRAM_BOT_TOKEN=
# Список user id через запятую (узнать id: бот @userinfobot в Telegram). Для /campaign список
# обязателен — без TELEGRAM_ALLOWED_USER_IDS команда отключена. Обычный чат: если пусто — всем.
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Общий чат для отчётов о фазах workflow.
# Для авто-подхвата Trello ToDo рекомендуем всегда задавать:
# - личный chat автора берётся из карточки (telegram_chat_id),
# - этот TELEGRAM_REPORT_CHAT_ID используется как второй (общий) получатель.
# TELEGRAM_REPORT_CHAT_ID=-1001234567890
# Poller ToDo -> InProgress -> start workflow:
# TRELLO_TODO_POLLER_ENABLED=false
# TRELLO_TODO_POLLER_INTERVAL_SEC=45
# Запуск: seo-os-telegram-bot

# --- Keyword sources (direct in-project + optional external adapter fallback) ---
# Для legacy adapter-режима:
# KEYWORD_SEARCH_BASE_URL=http://127.0.0.1:8088
# KEYWORD_SEARCH_API_KEY=
# KEYWORD_SEARCH_TIMEOUT_SEC=30
# Для direct-sources режима:
# KEYWORD_DIRECT_TIMEOUT_SEC=30
# KEYWORD_SEEN_FILE=runtime/keyword_seen_keywords.txt
# KEYWORD_SOURCE_PROFILE=cheap
# KEYWORD_SOURCE_TIMEOUTS=autocomplete:20,trends:40,youtube:30,ahrefs:45
# KEYWORD_SOURCE_BUDGETS=youtube:1200,ahrefs:2000
# KEYWORD_MERGE_MODE=topic_cap
# AHREFS_API_TOKEN=
# AHREFS_API_BASE_URL=https://api.ahrefs.com/v3/site-explorer/keywords
# YOUTUBE_API_KEY=
# /kw_trends (legacy adapter probe): длинный HTTP-клиент бота:
# KEYWORD_TRENDS_CONFIG_PATH=pipeline/config.json
# KEYWORD_PROBE_TRENDS_TIMEOUT_SEC=660
# Маршрут keyword-фазы для /campaign и seo-os-demo:
# KEYWORD_ADAPTER_ROUTE=direct_discovery
# KEYWORD_QUERY=bingo bonus
# KEYWORD_SEEDS=bonus app,free spins,no deposit
# KEYWORD_MODE=cheap_live
# KEYWORD_LIMIT=80
# KEYWORD_SOURCES=autocomplete,trends,youtube
# KEYWORD_HL=en
# KEYWORD_GL=us
# KEYWORD_TRENDS_SUBPROCESS_TIMEOUT_SEC=180
# KEYWORD_TRENDS_FILTER_BY_QUERY=true
# KEYWORD_TRENDS_SEED_MODE=merge
# KEYWORD_YOUTUBE_REGION_CODE=US
# KEYWORD_YOUTUBE_RELEVANCE_LANGUAGE=en
# KEYWORD_YOUTUBE_MAX_RESULTS=15
# KEYWORD_INCLUDE_RAW_REF=false
# Управление breadth/depth-итерациями в SeoCampaignWorkflow:
# KEYWORD_TARGET_CLUSTERS=40
# KEYWORD_TARGET_KEYWORDS=2000
# KEYWORD_MAX_ITERATIONS=4
# Значения route:
# - direct_discovery | direct_autocomplete | direct_trends | direct_youtube | direct_ahrefs
# - legacy: search | live_autocomplete | live_trends | live_youtube
