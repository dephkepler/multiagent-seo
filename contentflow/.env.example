# Postgres (used by docker-compose + Makefile)
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=contentflow
POSTGRES_DB=contentflow
POSTGRES_HOST_PORT=55432
APP_HOST_PORT=8080

# LLM — default provider & key
CF_LLM_PROVIDER=groq
CF_LLM_MODEL=llama-3.3-70b-versatile
CF_LLM_API_KEY=

# LLM — per-provider keys (optional, used when a request overrides `provider`)
CF_LLM_GROQ_API_KEY=
CF_LLM_CLAUDE_API_KEY=

# WordPress
CF_WORDPRESS_URL=
CF_WORDPRESS_USER=
CF_WORDPRESS_APP_PASSWORD=

# Telegram
CF_TELEGRAM_BOT_TOKEN=

# Google Sheets
CF_SHEETS_CREDENTIALS_FILE=./credentials.json
CF_SHEETS_SPREADSHEET_ID=
