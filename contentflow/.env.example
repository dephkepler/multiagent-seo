# Postgres (used by docker-compose + Makefile)
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=contentflow
POSTGRES_DB=contentflow
POSTGRES_HOST_PORT=55432
APP_HOST_PORT=8080

# LLM — default provider & key
CF_LLM_PROVIDER=groq
CF_LLM_MODEL=llama-3.3-70b-versatile
CF_LLM_API_KEY=

# LLM — per-provider keys (optional, used when a request overrides `provider`)
CF_LLM_GROQ_API_KEY=
CF_LLM_CLAUDE_API_KEY=

# WordPress
CF_WORDPRESS_URL=
CF_WORDPRESS_USER=
CF_WORDPRESS_APP_PASSWORD=

# Telegram
CF_TELEGRAM_BOT_TOKEN=

# DataForSEO — Basic Auth credentials from app.dataforseo.com/api-dashboard
CF_DATAFORSEO_LOGIN=
CF_DATAFORSEO_PASSWORD=
CF_DATAFORSEO_SERP_LIMIT=5

# Pexels — stock photos used to fill [IMG | ...] placeholders.
# Sign up at https://www.pexels.com/api/ to get a free API key
# (200 requests/hour). Set ENABLED=false to disable image lookup
# even when a key is present (placeholders get stripped).
CF_PEXELS_ENABLED=true
CF_PEXELS_API_KEY=

# Originality checker — "mock" until real provider is configured
# provider: mock | originality (requires Enterprise plan)
CF_CHECKER_PROVIDER=mock
CF_CHECKER_API_KEY=
CF_CHECKER_AI_THRESHOLD=0.8

# Google Sheets — leave CF_SHEETS_SPREADSHEET_ID empty to fall back to in-memory mock.
# Path is relative to the process CWD (host) or /app (container).
CF_SHEETS_CREDENTIALS_FILE=./credentials.json
CF_SHEETS_SPREADSHEET_ID=
# Tab name and column layout. Defaults match a sheet with columns:
#   A=topic, B=keyword, C=article_title (optional), first row = header.
CF_SHEETS_SHEET=Sheet1
CF_SHEETS_TOPIC_COLUMN=A
CF_SHEETS_KEYWORD_COLUMN=B
CF_SHEETS_TITLE_COLUMN=C
CF_SHEETS_HEADER_ROW=true
